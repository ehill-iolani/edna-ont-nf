params {
    // tests/data/ holds small synthetic fixtures generated by
    // tests/data/generate_synthetic_reads.py -- see that script for how the
    // three samples/species were tuned to land in each SORT_CONSENSUS bucket
    input      = 'tests/data/samplesheet.csv'
    taxdb      = 'tests/data/test_refs.fasta'
    min_len    = 100
    max_len    = 2000
    min_qual   = 10
    cluster_id = 0.85
    min_cluster = 5
}
