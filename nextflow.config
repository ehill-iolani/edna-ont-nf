manifest {
    name            = 'edna-ont-nf'
    description     = 'ONT eDNA amplicon classification pipeline (decona successor)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

params {
    // see main.nf for the full param list / help text
    outdir   = "results"
    tracedir = "${params.outdir}/pipeline_info"

    // chopper filtering thresholds -- declared here (not as script-level
    // `params.x = value` in main.nf) so they're reliably set before any
    // included module reads them; profiles like `test` can still override
    min_len  = 150
    max_len  = 300
    min_qual = 10

    // same reason: read directly inside the SORT_CONSENSUS/BUILD_REPORT
    // module scripts, so they must live here rather than in main.nf
    enable_medaka = false
    min_pident    = 90

    // same reason: read directly inside the ISONCLUST module script
    cluster_id  = 0.86
    min_cluster = 20
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled  = false
        docker.runOptions = '--platform linux/amd64'
    }
    conda {
        conda.enabled  = true
        docker.enabled = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    local {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
        // set process.queue / clusterOptions per institution HPC as needed
    }
    test {
        includeConfig 'conf/test.config'
    }
    google_batch {
        process.executor      = 'google-batch'
        process.errorStrategy = { task.exitStatus == 50001 ? 'retry' : 'terminate' }
        process.maxRetries    = 5
        process.container     = 'ubuntu:22.04'

        google.project        = 'iscc-400300'
        google.location       = 'us-central1'
        google.batch.spot     = true

        workDir               = 'gs://nextflow-jobs/edna/work'
        params.outdir         = 'gs://nextflow-jobs/edna/results'

        docker.enabled        = true

        // larger allotments than the base process block, scaling with
        // task.attempt so retries (see errorStrategy/maxRetries above)
        // get more room instead of repeatedly failing at the same size
        process {
            withLabel: process_low {
                cpus   = 4
                memory = { 8.GB  * task.attempt }
                time   = { 2.h   * task.attempt }
            }
            withLabel: process_medium {
                cpus   = 8
                memory = { 16.GB * task.attempt }
                time   = { 8.h   * task.attempt }
            }
            withLabel: process_high {
                cpus   = 16
                memory = { 32.GB * task.attempt }
                time   = { 16.h  * task.attempt }
            }
        }
    }
}

process {
    withLabel: process_low {
        cpus   = 2
        memory = '4.GB'
        time   = '1.h'
    }
    withLabel: process_medium {
        cpus   = 4
        memory = '8.GB'
        time   = '4.h'
    }
    withLabel: process_high {
        cpus   = 8
        memory = '16.GB'
        time   = '8.h'
    }
}

timeline {
    enabled = true
    file    = "${params.tracedir}/timeline.html"
}
report {
    enabled = true
    file    = "${params.tracedir}/report.html"
}
trace {
    enabled = true
    file    = "${params.tracedir}/trace.txt"
}
