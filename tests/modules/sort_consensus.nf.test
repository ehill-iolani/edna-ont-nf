nextflow_process {

    name "Test Process SORT_CONSENSUS"
    script "modules/sort_consensus.nf"
    process "SORT_CONSENSUS"

    test("routes each cluster's consensus fasta by its best BLAST hit confidence") {

        when {
            params {
                min_pident = 90
            }
            process {
                """
                input[0] = Channel.of(
                    tuple('sample_a', '0', file("${projectDir}/tests/data/report_consensus_1.fasta"), file("${projectDir}/tests/data/report_hits_1.tsv")),
                    tuple('sample_a', '1', file("${projectDir}/tests/data/report_consensus_2.fasta"), file("${projectDir}/tests/data/report_hits_2.tsv")),
                    tuple('sample_b', '0', file("${projectDir}/tests/data/report_consensus_3.fasta"), file("${projectDir}/tests/data/report_hits_3.tsv"))
                )
                """
            }
        }

        then {
            assert process.success
            assert process.out[0].size() == 3

            // published relative path is "{category}/{sample}.{cluster_id}.consensus.fasta"
            def outPaths = process.out[0].collect { it.toString() }

            // report_hits_1.tsv: pident 99.5 (>= min_pident) -> confident
            assert outPaths.any { it.contains('/confident/') && it.endsWith('sample_a.0.consensus.fasta') }

            // report_hits_2.tsv: NO_HIT -> no_hit
            assert outPaths.any { it.contains('/no_hit/') && it.endsWith('sample_a.1.consensus.fasta') }

            // report_hits_3.tsv: pident 85.176 (< min_pident) -> low_confidence
            assert outPaths.any { it.contains('/low_confidence/') && it.endsWith('sample_b.0.consensus.fasta') }
        }

    }

}
