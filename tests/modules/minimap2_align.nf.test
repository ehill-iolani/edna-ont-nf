nextflow_process {

    name "Test Process MINIMAP2_ALIGN"
    script "modules/minimap2_align.nf"
    process "MINIMAP2_ALIGN"

    setup {
        run("SPOA_CONSENSUS") {
            script "modules/spoa_consensus.nf"
            process {
                """
                input[0] = tuple(
                    'barcode17',
                    '0',
                    file("${projectDir}/tests/data/cluster_sample.fastq")
                )
                """
            }
        }
    }

    test("aligns cluster reads back to the draft consensus") {

        when {
            params { }
            process {
                """
                input[0] = SPOA_CONSENSUS.out.draft.map { sample, cluster_id, draft ->
                    tuple(sample, cluster_id, draft, file("${projectDir}/tests/data/cluster_sample.fastq"))
                }
                """
            }
        }

        then {
            assert process.success
            assert process.out.aligned.size() == 1

            def samFile = process.out.aligned[0][4]
            def lines = path(samFile).readLines()
            assert lines.any { it.startsWith('@') }               // header present
            def alignmentLines = lines.findAll { !it.startsWith('@') }
            assert alignmentLines.size() == 30                     // one record per read in the cluster
            // FLAG field (col 2) must not be 4 (unmapped) for reads that aligned to their own draft
            assert alignmentLines.every { it.split('\t')[1] != '4' }
        }

    }

}
