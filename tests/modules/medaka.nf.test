nextflow_process {

    name "Test Process MEDAKA"
    script "modules/medaka.nf"
    process "MEDAKA"

    setup {
        run("SPOA_CONSENSUS") {
            script "modules/spoa_consensus.nf"
            process {
                """
                input[0] = tuple(
                    'barcode17',
                    '0',
                    file("${projectDir}/tests/data/cluster_sample.fastq")
                )
                """
            }
        }
        run("MINIMAP2_ALIGN") {
            script "modules/minimap2_align.nf"
            process {
                """
                input[0] = SPOA_CONSENSUS.out.draft.map { sample, cluster_id, draft ->
                    tuple(sample, cluster_id, draft, file("${projectDir}/tests/data/cluster_sample.fastq"))
                }
                """
            }
        }
        run("RACON") {
            script "modules/racon.nf"
            process {
                """
                input[0] = MINIMAP2_ALIGN.out.aligned
                """
            }
        }
    }

    test("produces a final polished consensus fasta") {

        when {
            params { }
            process {
                """
                input[0] = RACON.out.polished
                """
            }
        }

        then {
            assert process.success
            assert process.out.consensus.size() == 1

            def consensusFasta = process.out.consensus[0][2]
            assert consensusFasta.toString().endsWith('barcode17.0.medaka.consensus.fasta')

            def text = path(consensusFasta).text
            assert (text =~ />/).size() == 1

            // medaka renames the record based on the racon draft's header, so
            // the sample/cluster-size header has to be stamped on afterward
            def header = text.readLines()[0]
            assert header.startsWith('>barcode17_0 ')
            assert header.contains('sample=barcode17')
            assert header.contains('cluster_size=30')  // reads in tests/data/cluster_sample.fastq

            def seq = text.readLines().drop(1).join('')
            assert seq.length() > 0
        }

    }

}
