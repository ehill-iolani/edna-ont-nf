nextflow_process {

    name "Test Process ISONCLUST"
    script "modules/isonclust.nf"
    process "ISONCLUST"

    test("clusters reads and emits a cluster fastq plus a cluster tsv") {

        when {
            params { }
            process {
                """
                input[0] = tuple(
                    'sample_a_part0',
                    file("${projectDir}/tests/data/reads/sample_a/part_0.fastq.gz")
                )
                """
            }
        }

        then {
            assert process.success
            assert process.out.clusters.size() == 1
            assert process.out.cluster_tsv.size() == 1

            def clusterFastqs = process.out.clusters[0][1]
            def files = clusterFastqs instanceof List ? clusterFastqs : [clusterFastqs]
            assert files.size() > 0

            def tsvFile = process.out.cluster_tsv[0][1]
            assert path(tsvFile).exists()
            assert !path(tsvFile).text.isEmpty()
        }

    }

}
