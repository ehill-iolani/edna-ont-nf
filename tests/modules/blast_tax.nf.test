nextflow_process {

    name "Test Process BLAST_TAX"
    script "modules/blast_tax.nf"
    process "BLAST_TAX"

    setup {
        run("MAKEBLASTDB") {
            script "modules/makeblastdb.nf"
            process {
                """
                input[0] = file("${projectDir}/tests/data/test_refs.fasta")
                """
            }
        }
    }

    test("reports a hit for a query matching a reference sequence") {

        when {
            params { }
            process {
                """
                input[0] = tuple('barcode17', '0', file("${projectDir}/tests/data/blast_query_hit.fasta"))
                input[1] = MAKEBLASTDB.out.db_files
                input[2] = MAKEBLASTDB.out.db_name
                """
            }
        }

        then {
            assert process.success

            def hitsFile = process.out.hits[0][2]
            def line = path(hitsFile).text.trim()
            def fields = line.split('\t')
            assert fields[1] == 'test_ref_1'          // sseqid
            assert (fields[2] as Double) > 95.0        // pident
        }

    }

    test("flags a no-hit query instead of dropping it") {

        when {
            params { }
            process {
                """
                input[0] = tuple('barcode17', '1', file("${projectDir}/tests/data/blast_query_nohit.fasta"))
                input[1] = MAKEBLASTDB.out.db_files
                input[2] = MAKEBLASTDB.out.db_name
                """
            }
        }

        then {
            assert process.success

            def hitsFile = process.out.hits[0][2]
            def line = path(hitsFile).text.trim()
            def fields = line.split('\t')
            // qseqid must be sample_clusterid, matching what a real blastn hit
            // would report from the consensus fasta's stamped header -- not the
            // bare cluster_id, or this row can't be joined back to its sample
            assert fields[0] == 'barcode17_1'
            assert line.contains('NO_HIT')
            assert line.contains('flag_for_manual_review')
        }

    }

}
