nextflow_process {

    name "Test Process BUILD_REPORT"
    script "modules/report.nf"
    process "BUILD_REPORT"

    test("aggregates hits and consensus fastas into an abundance table + qc html") {

        when {
            params {
                min_pident = 90
            }
            process {
                """
                input[0] = [
                    file("${projectDir}/tests/data/report_hits_1.tsv"),
                    file("${projectDir}/tests/data/report_hits_2.tsv"),
                    file("${projectDir}/tests/data/report_hits_3.tsv")
                ]
                input[1] = [
                    file("${projectDir}/tests/data/report_consensus_1.fasta"),
                    file("${projectDir}/tests/data/report_consensus_2.fasta"),
                    file("${projectDir}/tests/data/report_consensus_3.fasta")
                ]
                """
            }
        }

        then {
            assert process.success

            def table = path(process.out.report[0]).text
            def rows = table.trim().readLines()
            assert rows.size() == 4   // header + 3 clusters

            // sample_a_0: confident (pident 99.5 >= min_pident) -- no flag,
            // sample/cluster_size pulled from the consensus fasta header
            def confidentRow = rows.find { it.startsWith('sample_a_0\t') }
            assert confidentRow.contains('sample_a')
            assert confidentRow.contains('test_ref_1')
            assert confidentRow.endsWith('\t')   // flag_reason column is empty

            // sample_a_1: no BLAST hit at all
            def noHitRow = rows.find { it.startsWith('sample_a_1\t') }
            assert noHitRow.contains('NO_HIT')
            assert noHitRow.endsWith('\tno_hit')

            // sample_b_0: real hit, but below --min_pident
            def lowIdRow = rows.find { it.startsWith('sample_b_0\t') }
            assert lowIdRow.contains('sample_b')
            assert lowIdRow.contains('test_ref_2')
            assert lowIdRow.endsWith('\tlow_identity')

            def html = path(process.out[1][0]).text
            assert html.contains('Clusters processed: 3')
            assert html.contains('Clusters flagged for manual review (no hit or pident &lt; 90.0): 2')
            assert html.contains('sample_a')
            assert html.contains('sample_b')
        }

    }

}
